# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
*.egg-info/
dist/
build/
.python-version

# Environment / secrets
.env
.env.local
.env.*.local

# Data — raw module documents may be sensitive; pipeline artefacts are regenerable
data/raw/modules/*.pdf
data/raw/modules/*.docx
data/cache/*
# Track the small LLM response cache so the LLM-extraction numbers reproduce
# without re-running the model (the heavy embedding/graph caches stay ignored).
!data/cache/llm/
data/curriculum.db
data/curriculum_llm.db
data/processed/curriculum.db
# Pipeline JSON/TXT outputs (regenerated by `make pipeline`)
data/processed/*.json
data/processed/*.txt
# But figures are kept under version control as documentation
!data/processed/figures/
!data/processed/figures/*.png

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# transient SQLite WAL/SHM sidecars
*.db-wal
*.db-shm
