# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
*.egg-info/
dist/
build/
.python-version

# Environment / secrets
.env
.env.local
.env.*.local

# Data — raw module documents may be sensitive; pipeline artefacts are regenerable
data/raw/modules/*.pdf
data/raw/modules/*.docx
# Source programme-specification PDFs: provenance is the source URLs recorded in
# data/raw/standards/imperial_module_meta.json, so the binaries are not tracked
data/raw/standards/imperial_specs/
data/cache/*
# Track the small LLM response cache so the LLM-extraction numbers reproduce
# without re-running the model (the heavy embedding/graph caches stay ignored).
!data/cache/llm/
# The canonical and combined reference databases and the processed JSON/TXT
# outputs are committed as the reference run (regenerable via `make pipeline-all`).
data/curriculum_llm.db
data/processed/curriculum.db
*.db-wal
*.db-shm
# Figures are kept under version control as documentation
!data/processed/figures/
!data/processed/figures/*.png

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# transient SQLite WAL/SHM sidecars
*.db-wal
*.db-shm
