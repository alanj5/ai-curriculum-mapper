# Copy this file to .env and adjust for your deployment.
# All values are optional; sensible defaults are baked into curriculum_mapper/config.py.

# API server bind address. Use 0.0.0.0 in a container, 127.0.0.1 for local-only.
API_HOST=127.0.0.1
API_PORT=8000

# Comma-separated allow-list of origins permitted to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Path to the SQLite database. Override to use a volume mount in Docker.
# CURRICULUM_DB_PATH=/app/data/curriculum.db
